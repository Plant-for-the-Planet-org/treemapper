{
  "name": "treemapper",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "test": "turbo test",
    "postinstall": "patch-package",
    "clean": "turbo clean && rm -rf node_modules",
    "clean:deep": "rm -rf node_modules && rm -rf yarn.lock && find . -name 'node_modules' -type d -prune -exec rm -rf '{}' + && find . -name '.next' -type d -prune -exec rm -rf '{}' + && find . -name 'dist' -type d -prune -exec rm -rf '{}' + && find . -name '.turbo' -type d -prune -exec rm -rf '{}' + && find . -name 'build' -type d -prune -exec rm -rf '{}' +",
    "heroku-postbuild": "turbo build --filter=web && turbo build --filter=server",
    "start": "concurrently \"cd apps/web && PORT=$PORT yarn start\" \"cd apps/server && PORT=3001 yarn start:prod\"",
    "start:web": "cd apps/web && PORT=$PORT yarn start",
    "start:server": "cd apps/server && PORT=${SERVER_PORT:-3001} yarn start:prod",
    "type-check": "turbo type-check",
    "native:dev": "turbo dev --filter=mobile",
    "native:build": "turbo build --filter=mobile",
    "native:start": "turbo start --filter=mobile",
    "web:dev": "turbo dev --filter=web",
    "web:build": "turbo build --filter=web",
    "web:start": "turbo start --filter=web",
    "server:dev": "turbo dev --filter=server",
    "server:build": "turbo build --filter=server",
    "server:start": "turbo start --filter=server",
    "sync-server": "node syncServer.js",
    "dev:fullstack": "concurrently \"turbo dev --filter=web\" \"turbo dev --filter=server\""
  },
  "engines": {
    "node": "22.x.x"
  },
  "packageManager": "yarn@1.22.19",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "patch-package": "^8.0.0",
    "prettier": "^3.2.5",
    "turbo": "^2.2.3",
    "typescript": "5.5.4"
  },
  "dependencies": {
    "concurrently": "^9.2.0",
    "dotenv-cli": "^7.1.0"
  },
  "peerDependencies": {
    "react": "18.3.1",
    "react-dom": "18.2.0"
  },
  "resolutions": {
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-dom": "18.2.0",
    "@types/react": "18.2.6",
    "react-i18next": "16.5.0",
    "i18next": "25.7.3"
  }
}