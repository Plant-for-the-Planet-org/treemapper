# If npm is ever used in this repo, save exact versions (no ^ / ~) too.
save-exact=true

# Hard-block npm. This repo's pinning lives in yarn.lock plus the yarn-only
# "resolutions" field; npm reads neither, so `npm install` re-resolves the tree
# and silently undoes pinned security versions (measured: 9 of 22 pins lost).
#
# Paired with "engines": {"npm": "please-use-yarn"} in package.json, this fails
# with EBADENGINE *before* npm writes a package-lock.json or any node_modules.
# The root `preinstall` guard (scripts/only-yarn.js) is the second layer: it
# also catches pnpm, bun and yarn 2+, but only after npm has already resolved.
engine-strict=true
