# Dependencies
# Both patterns are needed: `node_modules` only matches the root one. Without
# `**/node_modules` a local `docker build` would copy the host's
# apps/*/node_modules over the ones installed in the deps stage, mixing macOS
# native binaries into a Linux image.
node_modules
**/node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Production builds
.next/
dist/
build/

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Git
.git/
.gitignore

# Documentation
README.md
*.md

# Test files
coverage/
.nyc_output/
test/
tests/
__tests__/
*.test.js
*.test.ts
*.spec.js
*.spec.ts

# Mobile app (excluded from container)
apps/mobile/

# Logs
logs/
*.log

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Cache directories
.cache/
.turbo/
.eslintcache

# Temporary folders
tmp/
temp/

# Docker files
Dockerfile*
docker-compose*
.dockerignore

