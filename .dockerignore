# Dependencies
# Both patterns are needed: `node_modules` only matches the root one. Without
# `**/node_modules` a local `docker build` would copy the host's
# apps/*/node_modules over the ones installed in the deps stage, mixing macOS
# native binaries into a Linux image.
node_modules
**/node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Production builds
.next/
dist/
build/

# Environment files
# `**/` is needed for the same reason as node_modules above: `.env` alone only
# matches the root file, so apps/*/.env and the E2E test account in
# apps/web/.env.e2e reached the build context. Heroku builds from git, where
# they never exist, and gets NEXT_PUBLIC_* as build args. A local build now
# works the same way: `next build` no longer picks up a developer's
# apps/web/.env.
.env*
**/.env*

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Git
.git/
.gitignore

# Documentation
README.md
*.md

# Playwright output. .auth/ holds a real access token from the E2E login.
**/.auth/
**/test-results/
**/playwright-report/
**/blob-report/

# Test files
coverage/
.nyc_output/
test/
tests/
__tests__/
*.test.js
*.test.ts
*.spec.js
*.spec.ts

# Mobile app (excluded from container)
apps/mobile/

# Logs
logs/
*.log

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Cache directories
.cache/
.turbo/
.eslintcache

# Temporary folders
tmp/
temp/

# Docker files
Dockerfile*
docker-compose*
.dockerignore

# Heroku
Procfile
heroku.yml

# Example files
example-*