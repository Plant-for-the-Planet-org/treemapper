{
  "//": "Dependencies are pinned to EXACT versions on purpose. Do not add ^ or ~, and do not run yarn upgrade without team review. A pre-commit guard (.githooks/pre-commit) warns on dependency changes.",
  "name": "server",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start:debug": "nest start --debug --watch",
    "heroku-postbuild": "yarn build",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "ts-node src/database/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "set-user-role": "ts-node scripts/create-admin.ts",
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/src/main",
    "dev": "nest start --watch"
  },
  "engines": {
    "node": "22.x",
    "yarn": "1.22.x"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1057.0",
    "@aws-sdk/s3-request-presigner": "3.1057.0",
    "@fastify/compress": "8.3.1",
    "@fastify/static": "10.1.2",
    "@nestjs/axios": "4.0.1",
    "@nestjs/bull": "11.0.4",
    "@nestjs/cache-manager": "3.1.2",
    "@nestjs/cli": "11.0.21",
    "@nestjs/common": "11.1.24",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.24",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.1.24",
    "@nestjs/platform-fastify": "11.1.24",
    "@nestjs/schedule": "6.1.3",
    "@nestjs/swagger": "11.4.4",
    "@nestjs/terminus": "11.1.1",
    "@turf/boolean-valid": "7.3.5",
    "@turf/invariant": "7.3.5",
    "@types/cache-manager-redis-store": "3.0.0",
    "@types/ioredis": "5.0.0",
    "@types/node": "22.19.19",
    "@types/redis": "4.0.11",
    "axios": "1.13.5",
    "bull": "4.16.5",
    "cache-manager": "7.2.8",
    "cache-manager-redis-store": "3.0.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.4",
    "dotenv": "16.6.1",
    "drizzle-orm": "0.43.1",
    "express-jwt": "8.5.1",
    "express-jwt-authz": "2.4.1",
    "fastify": "5.8.5",
    "handlebars": "4.7.9",
    "ioredis": "5.11.0",
    "jwks-rsa": "3.2.2",
    "nodemailer": "7.0.13",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "pg": "8.21.0",
    "redis": "5.12.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "swagger-ui-express": "5.0.1",
    "ts-node": "10.9.2",
    "typeorm": "0.3.30",
    "typescript": "5.9.3",
    "uuid": "11.1.1",
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.5",
    "@eslint/js": "9.39.4",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.1.24",
    "@swc/cli": "0.6.0",
    "@swc/core": "1.15.40",
    "@types/jest": "29.5.14",
    "@types/pg": "8.20.0",
    "@types/supertest": "6.0.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "globals": "16.5.0",
    "jest": "29.7.0",
    "prettier": "3.8.3",
    "source-map-support": "0.5.21",
    "supertest": "7.2.2",
    "ts-jest": "29.4.11",
    "ts-loader": "9.6.0",
    "tsconfig-paths": "4.2.0",
    "typescript-eslint": "8.60.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
