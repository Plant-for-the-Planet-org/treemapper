# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/

# Native
*.orig.*
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local
.env
# typescript
*.tsbuildinfo


#development
notes.txt

.vscode

# The prebuild output, and only that. The leading slash is load-bearing:
# without it these patterns match a folder called android/ or ios/ at ANY
# depth, which silently swallowed the native source of the local Expo module
# in modules/treemapper-garmin/android/ -- committed nothing, broke nobody
# else's build, and gave no warning.
/android/
/ios/
