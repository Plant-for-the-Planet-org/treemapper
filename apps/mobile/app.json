{
  "expo": {
    "name": "TreeMapper",
    "slug": "treemapper",
    "version": "2.9.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "treemapper",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#F0F7EA"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      [
        "onesignal-expo-plugin",
        {
          "mode": "development"
        }
      ],
      "@maplibre/maplibre-react-native",
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.0.21"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "The app require accesses to you gallery to let you share them while providing feedback."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "We need access to location to be able to register trees on planted location."
        }
      ],
      [
        "react-native-auth0",
        {
          "domain": "accounts.plant-for-the-planet.org"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "To take pictures of the trees you have planted, please allow access to your camera."
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/OpenSans-Regular.ttf",
            "./assets/fonts/OpenSans-Bold.ttf",
            "./assets/fonts/OpenSans-SemiBold.ttf",
            "./assets/fonts/OpenSans-ExtraBold.ttf",
            "./assets/fonts/OpenSans-Italic.ttf",
            "./assets/fonts/OpenSans-BoldItalic.ttf",
            "./assets/fonts/OpenSans-SemiBoldItalic.ttf"
          ]
        }
      ],
      "expo-localization",
      "expo-secure-store",
      "expo-router",
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      ["react-native-share", {}]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.pftp.treemapper",
      "deploymentTarget": "15.1",
      "associatedDomains": [
        "applinks:dev.treemapper.app",
        "applinks:treemapper.app"
      ],
      "entitlements": {
        "aps-environment": "development",
        "com.apple.security.application-groups": [
          "group.org.pftp.treemapper.onesignal"
        ],
        "com.apple.developer.associated-domains": [
          "applinks:dev.treemapper.app",
          "applinks:treemapper.app"
        ]
      },
      "infoPlist": {
        "NSFaceIDUsageDescription": "Allows App to use Face ID for a simpler sign in.",
        "NSLocationWhenInUseUsageDescription": "We need access to precise location to be able to register trees.",
        "ITSAppUsesNonExemptEncryption": false,
        "LSMinimumSystemVersion": "12.0",
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#007A49"
      },
      "permissions": [
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "minSdkVersion": 24,
      "compileSdkVersion": 35,
      "package": "org.pftp.treemapper",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "dev.treemapper.app"
            },
            {
              "scheme": "https",
              "host": "treemapper.app"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "hooks": {
      "postPublish": [
        {
          "file": "@bugsnag/expo/hooks/post-publish.js",
          "config": {}
        }
      ]
    }
  }
}
