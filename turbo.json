{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": ["NODE_ENV", "NEXT_PUBLIC_*"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "type-check": {
      "outputs": []
    },
    "test": {
      "outputs": []
    },
    "test:e2e": {
      "cache": false,
      "passThroughEnv": [
        "CI",
        "E2E_PORT",
        "E2E_FULLSTACK",
        "E2E_FULLSTACK_CI_NO_ARTIFACTS",
        "PLAYWRIGHT_*"
      ]
    }
  },
  "globalEnv": ["NODE_ENV"],
  "globalDependencies": ["package.json", "yarn.lock"]
}